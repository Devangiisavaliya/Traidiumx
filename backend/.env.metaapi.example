# TraidiumX broker / MetaTrader 5 integration
# Copy only the values you need into backend/.env.
# Keep disabled until the MetaApi Manager profile, MT5 groups, SMTP and public frontend URL are ready.

APP_PUBLIC_URL=https://your-traidiumx-domain.example

METAAPI_ENABLED=false
METAAPI_TOKEN=
METAAPI_ACCOUNT_MODE=manager
METAAPI_MANAGER_BASE_URL=https://mt-manager-api-v1.new-york.agiliumtrade.ai
METAAPI_PROVISIONING_BASE_URL=https://mt-provisioning-api-v1.agiliumtrade.agiliumtrade.ai
METAAPI_PROVISIONING_PROFILE_ID=
METAAPI_MT5_SERVER_NAME=
METAAPI_MT5_ACCOUNT_TYPE=
METAAPI_MT5_BASIC_GROUP=
METAAPI_MT5_STANDARD_GROUP=
METAAPI_MT5_ADVANCED_GROUP=
METAAPI_MT5_LEVERAGE=100
METAAPI_MT5_BROKER_KEYWORDS=TraidiumX
METAAPI_DEFAULT_COUNTRY=India
METAAPI_DEFAULT_STATE=Gujarat
METAAPI_DEFAULT_CITY=Ahmedabad
METAAPI_DEFAULT_ZIP=000000
METAAPI_DEFAULT_ADDRESS=Not provided
METAAPI_REQUEST_TIMEOUT=20
METAAPI_CREDENTIAL_LINK_HOURS=24

# Generate once and keep stable. Changing this key makes pending encrypted
# MT5 credentials unreadable.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
METAAPI_CREDENTIAL_ENCRYPTION_KEY=

PLAN_MONITOR_ENABLED=true
PLAN_MONITOR_INTERVAL_SECONDS=60

# Existing email delivery must also be configured before MT5 provisioning is enabled.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
