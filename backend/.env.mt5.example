# MetaTrader 5 integration (copy required values into backend/.env)

# Connect/import an existing MT5 account through MetaApi or your connector.
METAAPI_TOKEN=
METAAPI_REGION=new-york
METAAPI_PROVISIONING_URL=https://mt-provisioning-api-v1.agiliumtrade.agiliumtrade.ai/users/current/accounts
METAAPI_MAGIC=20260716

# Broker/white-label APIs for new account provisioning.
# These endpoints are provider-specific and must be supplied by your MT5 broker/white-label provider.
MT5_PROVISIONING_API_URL=
MT5_PROVISIONING_API_KEY=
MT5_PASSWORD_API_URL=
MT5_GROUP_API_URL=
MT5_FUNDING_API_URL=

MT5_BROKER_NAME=TraidiumX Broker
MT5_SERVER_NAME=TraidiumX-Live
MT5_ACCOUNT_CURRENCY=USD
MT5_API_TIMEOUT_SECONDS=15

# Used to build the secure MT5 password setup link sent by email.
APP_PUBLIC_URL=http://localhost:5500
